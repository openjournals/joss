<% if current_user.aeic? && JournalFeatures.tracks? %>
<div class="card" id="track-info">
  <div class="card-header">Track</div>
  <div class="card-body">
  <% if paper.meta_review_issue_id %>

    <% if paper.track %>
      <p class="card-text">
        This paper is assigned to the track: <strong><%= paper.track.name %></strong>.
      </p>
      <p class="card-text">
        This track is managed by:
        <ul>
          <% paper.track.aeics.each do |aeic| %>
            <li><%= aeic.full_name %> (<%= aeic.login %>)</li>
          <% end %>
          <%= "Track without AEiC" if paper.track.aeics.empty? %>
        </ul>
      </p>
    <% else %>
    <p class="card-text">
      This paper is <strong>not assigned to any track</strong>
      </p>
    <% end %>
  <% else %>
    <% if paper.suggested_subject %>
      <p class="card-text">
        Author suggested this paper' subject is <strong><%= paper.suggested_subject %></strong>
      </p>
    <% else %>
      <p class="card-text">
        Author didn't suggest any subject for this paper.
      </p>
    <% end %>

    <% if paper.track_id.present? %>
      <p class="card-text">
        This submission will be assigned to the track:  <strong><%= paper.track.name %></strong>
      </p>
      <p class="card-text">
        <%= paper.track.aeics.empty? ? "Track without AEiC" : "Track managed by:" %>
        <ul>
          <% paper.track.aeics.each do |aeic| %>
            <li><%= aeic.full_name %> (<%= aeic.login %>)</li>
          <% end %>
        </ul>
      </p>
      <% end %>
  <% end %>

  <%= link_to "Change track &raquo;".html_safe, "#changeTrack", title: "Change submission's track", data: { toggle: 'collapse'} %>

    <div class="row collapse" id="changeTrack">
      <div class="col-md-6">
        <%= form_tag(change_track_paper_url(paper), class: "left") do %>
          <%= select_tag :track_id, options_from_collection_for_select(Track.where.not(id: paper.track_id), "id", "name"), prompt: "Select new track", class: "form-control left" %>
          <%= submit_tag "Change paper's track", class: "btn btn-primary left change-track" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<br />
<% end %>

<% if current_user.aeic? %>
<div class="card border-danger" id="edit-metadata">
  <div class="card-header text-danger">&#9888; Edit paper metadata</div>
  <div class="card-body">
    <div class="alert alert-danger">
      <strong>&#9888; Warning:</strong> Directly editing paper metadata bypasses normal submission processes. Only use this to correct data errors (e.g. encoding issues in the title or tags). Any changes take effect immediately on the live site.
    </div>
    <%= link_to "Edit metadata &raquo;".html_safe, "#editMetadata", data: { toggle: 'collapse' } %>
    <div class="row collapse" id="editMetadata">
      <div class="col-md-9" style="margin-top: 1em;">
        <%= form_tag(update_metadata_paper_url(paper)) do %>
          <div class="form-group">
            <%= label_tag :title, "Title" %>
            <%= text_field_tag :title, paper.title, class: "form-control", placeholder: "Leave blank to keep current value" %>
          </div>
          <div class="form-group" style="margin-top: 0.75em;">
            <%= label_tag :tags, "Tags (comma-separated)" %>
            <%= text_field_tag :tags, paper.metadata.dig('paper', 'tags')&.join(', '), class: "form-control", placeholder: "Leave blank to keep current value" %>
            <small class="form-text text-muted">Tags that duplicate a displayed language are hidden from the Tags section on the paper page.</small>
          </div>
          <div class="form-group" style="margin-top: 0.75em;">
            <%= label_tag :languages, "Languages (comma-separated)" %>
            <%= text_field_tag :languages, paper.metadata.dig('paper', 'languages')&.join(', '), class: "form-control", placeholder: "Leave blank to keep current value" %>
            <small class="form-text text-muted">Some languages are never displayed on the paper page: <%= Paper::IGNORED_LANGUAGES.join(', ') %>.</small>
          </div>
          <div class="form-group" style="margin-top: 0.75em;">
            <%= label_tag :citation_string, "Citation string" %>
            <%= text_field_tag :citation_string, paper.citation_string, class: "form-control", placeholder: "Leave blank to keep current value" %>
          </div>
          <%= submit_tag "Update metadata", class: "btn btn-danger", style: "margin-top: 0.75em;", data: { turbo_confirm: "Are you sure you want to directly edit this paper's metadata?" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<br />
<% end %>

<% if current_user.aeic? %>
  <%
    author_orcid = paper.submitting_author.uid
    author_email = paper.submitting_author.email
    repo_owner = BlocklistEntry.repository_owner(paper.repository_url)
    orcid_blocked = BlocklistEntry.blocked_orcid?(author_orcid)
    email_blocked = BlocklistEntry.blocked_email?(author_email)
    repo_blocked = BlocklistEntry.blocked_repository?(paper.repository_url)
    block_reason = "Added from submission: #{paper.title.to_s.truncate(80)}"
    unblocked = BlocklistEntry.candidates_for(paper).reject do |kind, value|
      case kind
      when "orcid" then orcid_blocked
      when "email" then email_blocked
      else repo_blocked
      end
    end
  %>
  <div class="card border-danger" id="blocklist-actions">
    <div class="card-header text-danger">&#9888; Block list</div>
    <div class="card-body">
      <p class="card-text">
        Blocking prevents future submissions from this ORCID iD, email address or repository. It does not change this paper.
        <% if orcid_blocked || email_blocked || repo_blocked %>
          <br /><strong>Already blocked:</strong>
          <%= [("author's ORCID iD" if orcid_blocked), ("author's email" if email_blocked), ("repository" if repo_blocked)].compact.to_sentence %>.
          <%= link_to "Manage the block list &raquo;".html_safe, blocklist_entries_path %>
        <% end %>
      </p>

      <% if unblocked.any? %>
        <%= form_with(url: block_paper_path(paper.sha), local: true) do |f| %>
          <div class="form-group">
            <%= f.label :reason, "Reason for blocking" %>
            <%= f.text_field :reason, class: "form-control", placeholder: "e.g. spam submission, AI-generated paper, unrelated repository", required: true %>
          </div>
          <%= f.submit "Block all: #{unblocked.map { |kind, value| kind == 'repository' ? "https://#{value}" : value }.to_sentence}",
                class: "btn btn-danger",
                data: { turbo_confirm: "Block this submitter's #{unblocked.map(&:first).map { |k| k == 'orcid' ? 'ORCID iD' : k }.to_sentence} from future submissions?" } %>
        <% end %>
        <hr />
        <p class="card-text"><small>Or block individually:</small></p>
      <% end %>

      <div class="d-flex flex-wrap" style="gap: 0.5em;">
        <% unless orcid_blocked || author_orcid.blank? %>
          <%= form_with(url: blocklist_entries_path, local: true) do |f| %>
            <%= f.hidden_field "blocklist_entry[kind]", value: "orcid" %>
            <%= f.hidden_field "blocklist_entry[value]", value: author_orcid %>
            <%= f.hidden_field "blocklist_entry[reason]", value: block_reason %>
            <%= f.submit "Block author's ORCID iD (#{author_orcid})", class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Block ORCID iD #{author_orcid} from submitting to #{setting(:abbreviation)}?" } %>
          <% end %>
        <% end %>
        <% unless email_blocked || author_email.blank? %>
          <%= form_with(url: blocklist_entries_path, local: true) do |f| %>
            <%= f.hidden_field "blocklist_entry[kind]", value: "email" %>
            <%= f.hidden_field "blocklist_entry[value]", value: author_email %>
            <%= f.hidden_field "blocklist_entry[reason]", value: block_reason %>
            <%= f.submit "Block author's email (#{author_email})", class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Block #{author_email} from submitting to #{setting(:abbreviation)}?" } %>
          <% end %>
        <% end %>
        <% unless repo_blocked %>
          <%= form_with(url: blocklist_entries_path, local: true) do |f| %>
            <%= f.hidden_field "blocklist_entry[kind]", value: "repository" %>
            <%= f.hidden_field "blocklist_entry[value]", value: paper.repository_url %>
            <%= f.hidden_field "blocklist_entry[reason]", value: block_reason %>
            <%= f.submit "Block this repository", class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Block #{paper.repository_url} from being submitted again?" } %>
          <% end %>
          <% if repo_owner %>
            <%= form_with(url: blocklist_entries_path, local: true) do |f| %>
              <%= f.hidden_field "blocklist_entry[kind]", value: "repository" %>
              <%= f.hidden_field "blocklist_entry[value]", value: repo_owner %>
              <%= f.hidden_field "blocklist_entry[reason]", value: block_reason %>
              <%= f.submit "Block all repositories under #{repo_owner}", class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Block every repository under #{repo_owner}?" } %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <br />

  <div class="card" id="paper-actions">
    <div class="card-header">
      Paper actions
    </div>
    <div class="card-body">
      <p class="card-text">
        Current state: <strong><%= state_label(paper.state) %></strong>.
        Rejecting or withdrawing a paper is done with editorialbot on GitHub, not from here.
      </p>

      <% if paper.submitted? %>
        <%= form_tag(start_meta_review_paper_url(paper)) do %>
          <div class="input-group" style="max-width: 32em;">
            <%= select_tag :editor, options_for_select(Repository.editors, selected: nil), prompt: "Suggest editor (optional)", class: "custom-select" %>
            <div class="input-group-append">
              <%= submit_tag "Start pre review", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
        <hr />
      <% end %>

      <p class="card-text">
        If the state above doesn't match what happened on GitHub (e.g. a rejection was reversed), you can
        <%= link_to "fix the paper state &raquo;".html_safe, "#changeState", title: "Manually change this paper's state", data: { toggle: 'collapse' } %>
      </p>
      <div class="collapse" id="changeState">
        <div class="alert alert-danger">
          <strong>&#9888; Warning:</strong> This directly sets the paper's state and bypasses the normal workflow. Nothing changes on GitHub, so make sure the review issue already reflects the state you're setting here.
        </div>
        <%= form_tag(change_state_paper_url(paper)) do %>
          <div class="input-group" style="max-width: 32em;">
            <%= select_tag :state, options_for_select(state_options(Paper::MANUALLY_ASSIGNABLE_STATES - [paper.state])), prompt: "Select new state", class: "custom-select", required: true %>
            <div class="input-group-append">
              <%= submit_tag "Change paper state", class: "btn btn-danger", data: { turbo_confirm: "This will manually change the paper's state and bypass the normal review workflow. Are you sure?" } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <br />
<% end %>
