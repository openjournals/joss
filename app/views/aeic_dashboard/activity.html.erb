<div class="container">
  <p id="notice"><%= notice %></p>
  <div class="col-7">
    <div class="welcome">Editors in Chief Dashboard</div>
    <div class="hero-small dashboard">
      <div class="hero-title">
        <%= image_tag "icon_papers.svg", height: "32px" %><h1>Issue activity</h1>
      </div>
      <div class="welcome" style="padding-left:20px"><%= "Track: #{@track.name}" if @track.present? %></div>
    </div>
  </div>
</div>

<%= render partial: "aeic_dashboard/menu" %>
<div class="container">
  <div class="generic-content-item">
    <p>
      Accounts commenting on review issues, ranked by how many <strong>distinct issues</strong> they have been active on.
      Editors and <strong>@<%= Rails.application.settings["bot_username"] %></strong> are excluded.
      Issues where the commenter is neither the submitting author nor an assigned reviewer are counted under <strong>No role</strong>.
      A high number there over a short window is the usual signature of unsolicited "I can review" offers.
    </p>

    <p>
      Window:
      <% IssueComment::WINDOWS.each do |days| %>
        <% label = days == 1 ? "Last 24 hours" : "Last #{days} days" %>
        <% if days == @days %>
          <strong><%= label %></strong>
        <% else %>
          <%= link_to label, aeic_activity_path(days: days, track_id: params[:track_id].presence) %>
        <% end %>
        <%= "·" unless days == IssueComment::WINDOWS.last %>
      <% end %>
    </p>

    <% if @leaderboard.empty? %>
      <p>There are <b>no comments from non-editor accounts</b> in this window.</p>
    <% else %>
      <table class="dashboard-table sortable">
        <thead>
          <tr class="text-nowrap">
            <th scope="col">Account</th>
            <th scope="col">Distinct issues</th>
            <th scope="col">No role</th>
            <th scope="col">Comments</th>
            <th scope="col">Last comment</th>
            <th scope="col" class="sorttable_nosort">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @leaderboard.each do |row| %>
            <tr>
              <td sorttable_customkey="<%= row.login %>">
                <%= image_tag(avatar(row.login), size: "24x24", class: "avatar", title: github_user_link(row.login)) %>
                <%= link_to "@#{row.login}", github_user_link(row.login), title: "GitHub profile", target: "_blank" %>
              </td>
              <td><%= row.issues_count %></td>
              <td><%= row.no_role_issues_count %></td>
              <td><%= row.comments_count %></td>
              <td sorttable_customkey="<%= row.last_commented_at.to_i %>"><%= time_ago_in_words(row.last_commented_at) %> ago</td>
              <td><%= link_to "Show comments", aeic_activity_path(days: @days, track_id: params[:track_id].presence, login: row.login, anchor: "comments") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <% if @login.present? %>
    <div id="comments" class="generic-content-item">
      <h2>Comments by @<%= @login %></h2>
      <% if @login_comments.empty? %>
        <p>No comments from <strong>@<%= @login %></strong> in this window.</p>
      <% else %>
        <table class="dashboard-table">
          <thead>
            <tr class="text-nowrap">
              <th scope="col">When</th>
              <th scope="col">Issue</th>
              <th scope="col">Paper</th>
              <th scope="col">Role</th>
              <th scope="col">Comment</th>
            </tr>
          </thead>
          <tbody>
            <% @login_comments.each do |comment| %>
              <tr>
                <td class="text-nowrap"><%= time_ago_in_words(comment.commented_at) %> ago</td>
                <td class="text-nowrap"><%= link_to "##{comment.issue_id}", comment.github_issue_url, target: "_blank" %> (<%= comment.kind %>)</td>
                <td><%= truncate(comment.paper.title, length: 80) %></td>
                <td><%= comment.role %></td>
                <td><%= link_to "View on GitHub &rarr;".html_safe, comment.comment_url, target: "_blank" if comment.comment_url.present? %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
</div>
