<div class="container">
  <div class="row dashboard">
    <div class="col-7">
      <div class="welcome">Welcome, <%= current_user.editor.full_name %></div>
      <div class="hero-small dashboard">
        <div class="hero-title">
          <%= image_tag "icon_papers.svg", height: "32px" %><h1>Associate-Editors-in-Chief Dashboard</h1>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render partial: "menu" %>

<div class="container">
  <div class="generic-content-item">
    <h2>Editor emails</h2>
    <p>Download CSV lists (name, GitHub handle, email) of the current editorial team.</p>
    <ul>
      <li><%= link_to "EiC & AEiC emails (#{@board_count})", aeic_editor_emails_path(format: :csv, group: "board") %></li>
      <li><%= link_to "Topic editor emails (#{@topic_count})", aeic_editor_emails_path(format: :csv, group: "topic") %></li>
    </ul>
  </div>
</div>
